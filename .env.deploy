# ─── 部署配置 (.env.deploy → 复制为 .env 后使用) ───────────────────────────

# 镜像地址（构建后填入你推送的地址）
IMAGE=ccr.ccs.tencentyun.com/clobotics/labelstudio-storelayout:latest-amd64

# 对外暴露的 HTTP 端口
HTTP_PORT=8080

# Django 密钥（生产环境必须改成随机字符串）
# 生成方法：python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=4BokNzjjgVlVeiqhN43Tdm6uh-QxO6XZE0RxJwLv14FUx4XL6rhKRWwLJ_f_9fpYGFM

# PostgreSQL 密码（留空 = trust 模式，仅内网可接受）
POSTGRES_PASSWORD=clobotics

# 强制使用 PostgreSQL（避免部署平台注入变量时误切到 sqlite）
DJANGO_DB=default
LABEL_STUDIO_DJANGO_DB=default

# 公网访问地址（用于邮件里的链接，留空则自动检测）
# 例如：http://192.168.1.100:8080
# LABEL_STUDIO_HOST=http://localhost:8080
LABEL_STUDIO_HOST=https://storelayout-labelingtool.clobotics.cn

# CSRF 信任域（必须与公网访问地址一致，否则登录返回 403）
# CSRF_TRUSTED_ORIGINS=http://localhost:8080
CSRF_TRUSTED_ORIGINS=https://storelayout-labelingtool.clobotics.cn

# 默认管理员账号（首次启动自动创建，已有账号时忽略）
LABEL_STUDIO_USERNAME=admin@clobotics.com
LABEL_STUDIO_PASSWORD=Clobotics@2026

# 数据存储目录（容器内路径，部署平台会映射到宿主机）
BASE_DATA_DIR=/label-studio/data
